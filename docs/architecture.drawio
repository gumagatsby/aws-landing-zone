ixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1770" y="346" width="20" height="20" as="geometry"/></mxCell><mxCell id="c65" value="Security services are run centrally from the security-tooling account." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1798" y="344" width="270" height="64" as="geometry"/></mxCell><mxCell id="c66" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1770" y="416" width="20" height="20" as="geometry"/></mxCell><mxCell id="c67" value="People sign in once through IAM Identity Center. No IAM users, no access keys." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1798" y="414" width="270" height="64" as="geometry"/></mxCell><mxCell id="c68" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1770" y="486" width="20" height="20" as="geometry"/></mxCell><mxCell id="c69" value="Every account has a budget alert. Sandbox is cost-capped by policy." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1798" y="484" width="270" height="64" as="geometry"/></mxCell><mxCell id="c70" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1770" y="556" width="20" height="20" as="geometry"/></mxCell><mxCell id="c71" value="All of it is Terraform, tested on every push without a live organisation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1798" y="554" width="270" height="64" as="geometry"/></mxCell><mxCell id="c72" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1770" y="634" width="300" height="20" as="geometry"/></mxCell><mxCell id="c73" value="Pink dashed: access and delegation&lt;br&gt;Grey: log flow&lt;br&gt;Red boxes: guardrails (SCPs)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1770" y="656" width="300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>