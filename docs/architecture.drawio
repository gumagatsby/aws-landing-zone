lign=left;verticalAlign=top;fontSize=12;fontColor=#CD2264;fontFamily=Helvetica;" vertex="1" parent="1" ><mxGeometry x="740" y="790" width="900" height="20" as="geometry"/></mxCell><mxCell id="guard-list" value="No leaving the organisation · Root user denied · CloudTrail cannot be stopped or edited · Landing zone role protected · Security services cannot be disabled · Only eu-west-2 and eu-west-1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1" ><mxGeometry x="740" y="815" width="900" height="40" as="geometry"/></mxCell><mxCell id="every" value="Every account: one budget alert · Identity Center access only · logs to log-archive" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1" ><mxGeometry x="740" y="870" width="900" height="20" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=light-dark(#232F3E,#D4D4D4);fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engineers" target="idc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1-label" value="sign in once" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e1"><mxGeometry relative="1" x="0" y="-12" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=light-dark(#232F3E,#D4D4D4);fontFamily=Helvetica;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="orgs" target="aa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="306"/><mxPoint x="560" y="420"/><mxPoint x="250" y="420"/><mxPoint x="250" y="602"/></Array></mxGeometry></mxCell><mxCell id="e2-label" value="delegated admin" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e2"><mxGeometry relative="1" x="-0.55" y="-12" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=light-dark(#232F3E,#D4D4D4);fontFamily=Helvetica;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="trail" target="logbucket"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="306"/><mxPoint x="900" y="614"/></Array></mxGeometry></mxCell><mxCell id="e3-label" value="every API call" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e3"><mxGeometry relative="1" x="0.5" y="0" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="step-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="165" y="255" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="575" y="330" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1" ><mxGeometry x="860" y="330" width="28" height="28" as="geometry"/></mxCell><mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1" ><mxGeometry x="1760" y="30" width="650" height="985" as="geometry"/></mxCell><mxCell id="legend-container" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1780" y="60" width="602" height="945" as="geometry"/></mxCell><mxCell id="step-1-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="0" width="600" height="58" as="geometry"/></mxCell><mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-1-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;Sign in&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Engineers sign in once through IAM Identity Center and get time-limited roles in each account. No IAM users, no access keys.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend" ><mxGeometry x="52" y="0" width="548" height="58" as="geometry"/></mxCell><mxCell id="step-2-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="62" width="600" height="58" as="geometry"/></mxCell><mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-2-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;Delegate&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Organizations delegates security administration to the security-tooling account, which runs Access Analyzer, GuardDuty and Security Hub centrally.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend" ><mxGeometry x="52" y="0" width="548" height="58" as="geometry"/></mxCell><mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="124" width="600" height="58" as="geometry"/></mxCell><mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend" ><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Audit&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;One organisation-wide CloudTrail writes every API call from every account to a locked bucket in log-archive.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend" ><mxGeometry x="52" y="0" width="548" height="58" as="geometry"/></mxCell><mxCell id="legend-aux-note" value="&lt;i&gt;Service control policies set rules no account can break, not even its administrators. Every account has a budget alert; sandbox is cost-capped by policy. GitHub Actions runs terraform test (19, mocked AWS), IAM Access Analyzer and Checkov on every push.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=light-dark(#333333,#D4D4D4);fontFamily=Helvetica;" vertex="1" parent="legend-container" ><mxGeometry x="0" y="190" width="600" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>